function YCc(a){var b=s$.signupPricingPageUrl(),c=new Sm(s$.PRO_NOTEBOOK);qL(c.queryData_);var d=c.toString();a=a.manageSubscriptionUrl||"https://payments.google.com";c="In the version of Colab that is free of charge notebooks can run for at most 12 hours, depending on availability and your usage patterns. "+xH+" and "+yH+" offer you increased compute availability based on your compute unit balance.";var e=zH+" offers background execution which supports continuous code execution for up to 24 hours. Idle timeouts only apply if code execution terminates.",
f="You can fully relax any runtime limits and idle timeouts by purchasing a dedicated VM at "+ij(wH,"a",{href:"https://research.google.com/colaboratory/marketplace.html",target:"_blank"})+"GCP Marketplace"+kj(wH,"a")+".";c={hash:"timeout",itemTitle:"How long can notebooks run in Colab?",description:["Colab prioritizes interactive compute. Runtimes will time out if you are idle.",c,e,wH.format(f)]};e={hash:"background",itemTitle:"What is \u201cbackground execution\u201d?",description:["Pro+ users with a positive Colab compute unit balance automatically have background execution enabled for their notebooks, causing execution to continue after the browser closes up to a maximum runtime limit of up to 24 hours. Background execution only applies during an execution state: idle times will still result in VM deletion. Your output will be saved to Drive after the completion of each cell execution, even if your browser is closed. Resources are not guaranteed and usage limits still apply.",
xH+" users will see extended execution times and saving of output to Drive based on availability.","Users without a paid subscription should not rely on execution to continue in the background; execution will be interrupted when user interaction ceases, and the VM will be deleted soon after that."]};f="You can purchase guaranteed resources via "+ij(wH,"a",{href:"https://research.google.com/colaboratory/marketplace.html",target:"_blank"})+"GCP Marketplace"+kj(wH,"a")+".";f={hash:"resources",itemTitle:"Why aren't resources guaranteed in Colab?",
description:["In order to dynamically offer powerful GPUs at scale for a low price, Colab needs to maintain the flexibility to adjust usage limits and hardware availability dynamically.","In the version of Colab that is free of charge, access to expensive resources like GPUs is heavily restricted. For the paid version of Colab, we target giving our users high value for their spend.",wH.format(f)]};var h="Consider closing your Colab tabs or disconnecting from your runtime when you are done working and avoid utilizing GPUs when it is unnecessary for your work. This will make it less likely that you will run into usage limits within Colab. You can always "+
