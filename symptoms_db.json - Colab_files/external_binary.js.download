l8.interactiveSheetsNextStepsSnippet=function(a){return"from google.colab import sheets\nsheet = sheets.InteractiveSheet(df="+a+")"};l8.ADD_PROMPT_SNIPPET='# @title Prompt Gemini\n# @markdown Before running this cell, make sure to:\n# @markdown 1. Create an API key in [Google AI Studio](https://aistudio.google.com/app/apikey); and\n# @markdown 2. Add it to your Colab secrets as `GOOGLE_API_KEY`.\n\nfrom google import genai\nfrom google.colab import userdata\n\napi_key_secret_name = \'GOOGLE_API_KEY\' # @param {"type": "string", "placeholder": "e.g. GOOGLE_API_KEY"}\n\n# @markdown ---\n\n# @markdown Select a Gemini model to use.\nmodel = \'gemini-2.0-flash\' # @param {"type": "string"} ["gemini-2.0-flash-lite", "gemini-2.0-flash", "gemini-2.5-flash-preview-04-17", "gemini-2.5-pro-preview-05-06"]\n# @markdown Ask Gemini anything!\nprompt = \'Why is the sky blue?\' # @param {"type": "string", "placeholder": "e.g. Why is the sky blue?"}\n\n# @markdown ---\n\n# @markdown **[Optional] Configure the model\'s behavior.**\n\n# @markdown Add instructions to steer the model\'s response. For example, `"Answer concisely."` or `"Speak like a pirate."`.\nsystem_instruction = \'\' # @param {"type": "string", "placeholder": "e.g. Answer concisely."}\n# @markdown Set the temperature of the response. Lower temperatures lead to more straightforward responses, and higher temperatures lead to more creative responses.\ntemperature = 0.5 # @param {"type": "slider", "min": 0, "max": 2, "step": 0.05}\n\n# Create a Gemini client (that will use your API key).\napi_key = userdata.get(api_key_secret_name)\nclient = genai.Client(api_key=api_key)\n\n# Ask Gemini to generate a response.\nresponse = client.models.generate_content(\n    model=model,\n    contents=prompt,\n    config=genai.types.GenerateContentConfig(\n        system_instruction=system_instruction,\n        temperature=temperature,\n    )\n)\nprint(response.text)\n';
